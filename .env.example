SECRET_KEY=ganti-dengan-string-acak-minimal-32-karakter
DB_PASSWORD=narative
DB_ROOT_PASSWORD=root
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173
DOCUMENT_PARSER=auto
VITE_API_URL=http://localhost:8000
# Khusus pengembangan: true = semua akun diperlakukan sebagai High Tier (tanpa perlu bayar). Jangan aktifkan di produksi.
DEV_UNLOCK_ALL_TIERS=false
# Pembayaran: kosong = mode simulasi (panel metode contoh + tombol "simulasikan pembayaran"). Isi untuk memakai Midtrans.
# MIDTRANS_CLIENT_KEY wajib bila kunci server diisi: metode pembayaran tampil di dalam halaman lewat Midtrans Snap (aktifkan Snap dan metode yang diinginkan di dashboard Midtrans).
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
# Email (kode verifikasi, lupa kata sandi, invoice): kosong = email hanya dicatat di log server
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=NARAtive <no-reply@narative.local>
ROUTER_BASE_URL=http://9router:20128/v1
ROUTER_API_KEY=
ROUTER_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Opsional: model cadangan dan model khusus deskripsi tokoh (kuota Gemini dihitung per model)
GEMINI_FALLBACK_MODEL=
GEMINI_CHARACTER_MODEL=
# Banyak panggilan LLM yang boleh berjalan bersamaan saat mendeteksi tokoh (turunkan bila 9router sering membatasi)
CHARACTER_PARALLEL=3
# Batas ukuran satu unggahan (MB)
MAX_UPLOAD_MB=100
# Pembacaan PDF hasil scan (otomatis, tidak tampil di UI). Bahasa dipakai sesuai paket Tesseract yang terpasang.
OCR_ENABLED=true
OCR_LANGUAGES=ind+eng
OCR_DPI=200
# Dokumen yang jelas bukan novel (artikel, makalah, catatan) tidak dianalisis dan tidak memakai kuota; false mematikan pemeriksaan ini
DOCUMENT_TYPE_CHECK=true
# Mesin OCR: auto (Tesseract dulu, halaman berkeyakinan rendah dibaca ulang lewat 9router/Gemini), tesseract (saja), atau router (halaman scan langsung lewat 9router/Gemini)
OCR_ENGINE=auto
OCR_TIMEOUT=120
VISION_BATCH_PAGES=8
VISION_BATCH_MB=6
VISION_MAX_PAGES=60
# Kosongkan bila Tesseract ada di lokasi standar; isi dengan folder tessdata bila tidak
TESSDATA_DIR=
