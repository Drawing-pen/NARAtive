SECRET_KEY=ganti-dengan-string-acak-minimal-32-karakter
DB_PASSWORD=narative
DB_ROOT_PASSWORD=root
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173
DOCUMENT_PARSER=auto
VITE_API_URL=http://localhost:8000
# Khusus pengembangan: true = semua akun diperlakukan sebagai High Tier (tanpa perlu bayar). Jangan aktifkan di produksi.
DEV_UNLOCK_ALL_TIERS=false
# Pembayaran: kosong = mode simulasi (VA palsu + tombol "simulasikan pembayaran"). Isi untuk memakai Midtrans.
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false
# Email (kode verifikasi, lupa kata sandi, invoice): kosong = email hanya dicatat di log server
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=NARAtive <no-reply@narative.local>
ROUTER_BASE_URL=
ROUTER_API_KEY=
ROUTER_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Opsional: model cadangan dan model khusus deskripsi tokoh (kuota Gemini dihitung per model)
GEMINI_FALLBACK_MODEL=
GEMINI_CHARACTER_MODEL=
# Banyak panggilan LLM yang boleh berjalan bersamaan saat mendeteksi tokoh (turunkan bila 9router sering membatasi)
CHARACTER_PARALLEL=3
